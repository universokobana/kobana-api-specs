{
  "name": "kobana-developers-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "prepare-specs": "node scripts/prepare-specs.mjs",
    "gen-api-docs": "docusaurus gen-api-docs",
    "clean-api-docs": "docusaurus clean-api-docs",
    "gen-api-docs:all": "npm run prepare-specs && docusaurus clean-api-docs all && docusaurus gen-api-docs all && node scripts/fix-info-pages.mjs && node scripts/rewrite-legacy-links.mjs",
    "start": "docusaurus start --port 3300",
    "build": "npm run gen-api-docs:all && docusaurus build",
    "preview": "npm run build && docusaurus serve --port 3300",
    "serve": "docusaurus serve --port 3300",
    "swizzle": "docusaurus swizzle",
    "clear": "docusaurus clear",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.1",
    "@docusaurus/faster": "^3.10.1",
    "@docusaurus/preset-classic": "^3.10.1",
    "@docusaurus/theme-mermaid": "^3.10.1",
    "@fontsource-variable/syne": "^5.2.7",
    "@fontsource-variable/work-sans": "^5.2.8",
    "@fontsource/syne": "^5.2.7",
    "@fontsource/work-sans": "^5.2.8",
    "@mdx-js/react": "^3.0.0",
    "@signalwire/docusaurus-plugin-llms-txt": "^1.2.2",
    "clsx": "^2.0.0",
    "docusaurus-plugin-openapi-docs": "^5.0.2",
    "docusaurus-theme-openapi-docs": "^5.0.2",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.1",
    "@docusaurus/tsconfig": "^3.10.1",
    "@docusaurus/types": "^3.10.1",
    "typescript": "~5.6.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "glob": "^13.0.0",
    "inflight": "npm:lru-cache@^11.0.0",
    "uuid": "^11.1.1"
  }
}
