{"title":"Body","body":{"content":{"application/json":{"schema":{"type":"object","description":"New Utility Account Payment.","required":["amount","financial_account_uid","code"],"properties":{"amount":{"type":"number","format":"float","example":120.99,"description":"Amount\n"},"scheduled_to":{"type":"string","format":"date","nullable":true,"description":"Scheduling Date","example":"2023-12-12"},"financial_account_uid":{"type":"string","format":"uuid","description":"UID of the Origin Financial Account","example":"018df180-7208-727b-a10a-ea545e4a75a8"},"payment_account_uid":{"type":"string","format":"uuid","nullable":true,"description":"Payment account of origin (optional). If omitted, the oldest from the financial account is used. If provided, must belong to `financial_account_uid`.","example":"018df180-7208-727b-a10a-ea545e4a75a8"},"external_id":{"type":"string","nullable":true,"example":"123456-abc-789","description":"ID in your system. Optional for internal control."},"custom_data":{"type":"object","nullable":true,"example":"{\"codigo\": \"123\", \"vip\": true}","description":"Hash with key and value in JSON format."},"tags":{"type":"array","nullable":true,"description":"Associated tags","items":{"type":"string","example":"tag1"}},"code":{"type":"string","description":"Barcode or Typable Line"}},"title":"v2_new_payment_utility"}}},"required":true,"description":"Parameters for creating a Payment"}}