{"title":"Body","body":{"content":{"application/json":{"schema":{"type":"object","description":"New Automatic Pix request. The Automatic Pix account is inherited from the recurrence.","required":["expire_at","addressee_financial_account"],"properties":{"expire_at":{"type":"string","format":"date_time","description":"Expiration date of the request."},"external_id":{"type":"string","nullable":true,"description":"External ID of the request."},"custom_data":{"type":"object","nullable":true,"description":"Custom data."},"tags":{"type":"array","items":{"type":"string"},"nullable":true,"description":"Tags."},"addressee_financial_account":{"type":"object","description":"Financial Account of the Recipient (payer user)","required":["kind","account_number","account_digit","agency_number","bank","person_info"],"properties":{"kind":{"type":"string","enum":["checking","savings","payment"],"description":"Type of account"},"account_number":{"type":"string","description":"Account number (without the check digit)"},"account_digit":{"type":"string","description":"Account check digit"},"agency_number":{"type":"string","description":"Branch number"},"bank":{"type":"object","properties":{"ispb_number":{"type":"string","description":"ISPB code of the bank"}}},"person_info":{"type":"object","required":["document_type","document_number","kind","name"],"properties":{"document_type":{"type":"string","enum":["CPF","CNPJ"],"description":"Type of document"},"document_number":{"type":"string","description":"Number of the account holder's document"},"kind":{"type":"string","enum":["natural","juridical"],"description":"Type of person"},"name":{"type":"string","description":"Name of the account holder"}}}}}},"title":"v2_new_automatic_pix_request"}}}}}